{
  "name": "@devotedemocracy/record-verifier",
  "version": "0.1.0",
  "description": "Independent verifier for the Devote Public Record (record.devotedemocracy.com): formats, Merkle proofs, signed checkpoints, commitments, disclosure rules and recounts.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": "github:Devote-Democracy/record-verifier",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./schemas/record-v1.schema.json": "./schemas/record-v1.schema.json"
  },
  "files": [
    "dist",
    "schemas",
    "SPEC.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.8.3"
  }
}